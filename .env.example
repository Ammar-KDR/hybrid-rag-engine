# ============================================================
# LLM Backend Selection ('ollama', 'lm_studio', 'gemini')
# ============================================================

LLM_BACKEND=ollama

# Ollama (Default for Hackathon):
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# LM Studio (Alternative local server):
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen/qwen3-4b-2507

# Fast demo mode: set to false for <3s answers; true for full verification
ENABLE_VERIFICATION=false


# ============================================================
# Vector Database (Qdrant)
# ============================================================

# Storage mode: 'local' (Embedded disk, NO Docker needed!) or 'docker' (connects via HTTP)
QDRANT_STORAGE_MODE=local
QDRANT_LOCAL_PATH=data/qdrant_storage

# Docker/Remote Qdrant URL (used if QDRANT_STORAGE_MODE=docker):
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents


# ============================================================
# Models
# ============================================================

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=BAAI/bge-reranker-base


# ============================================================
# Data Paths
# ============================================================

DATA_PATH=data/raw
CHUNK_STORE_PATH=data/indexes/chunks.jsonl
REGISTRY_PATH=data/registry.json


# ============================================================
# Application
# ============================================================

LOG_LEVEL=INFO